{
  "name": "@csbot/desktop",
  "productName": "csbot",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node scripts/start.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "node build.mjs && playwright test",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/stage.mjs && electron-builder --config electron-builder.config.cjs --win nsis --publish never"
  },
  "dependencies": {
    "@csbot/coach": "workspace:*",
    "@csbot/engine": "workspace:*",
    "@csbot/gsi": "workspace:*",
    "@csbot/protocol": "workspace:*",
    "@csbot/scout": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@csbot/room": "workspace:*",
    "@csbot/room-relay": "workspace:*",
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
